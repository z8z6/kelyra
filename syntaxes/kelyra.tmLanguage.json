{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kelyra",
  "scopeName": "source.kelyra",
  "fileTypes": [
    "kly"
  ],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#annotations" },
    { "include": "#builtinMembers" },
    { "include": "#identifiers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kelyra",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.kelyra",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.kelyra",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.kelyra",
          "match": "\\\\[\\\\\"nrt0]"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.kelyra" },
            "2": { "name": "entity.name.function.kelyra" }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.class.kelyra" },
            "2": { "name": "entity.name.type.class.kelyra" }
          }
        },
        {
          "match": "\\b(alias)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.kelyra" },
            "2": { "name": "entity.name.type.kelyra" }
          }
        },
        {
          "match": "\\b(annotation)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.annotation.kelyra" },
            "2": { "name": "entity.name.type.annotation.kelyra" }
          }
        },
        {
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.kelyra" },
            "2": { "name": "entity.name.namespace.kelyra" }
          }
        },
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.kelyra" },
            "2": { "name": "entity.name.namespace.kelyra" }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.kelyra" },
            "2": { "name": "variable.other.readwrite.kelyra" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kelyra",
          "match": "\\b(if|else|while|return|break|continue|when|defer|asm)\\b"
        },
        {
          "name": "storage.modifier.kelyra",
          "match": "\\b(let|const|pub|extern|parallel|meta|var)\\b"
        },
        {
          "name": "constant.language.boolean.kelyra",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.kelyra",
          "match": "\\b(i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f32|f64|f128|f256|f512|bool|char|void)\\b"
        },
        {
          "name": "storage.type.c.kelyra",
          "match": "\\bc\\.(char|schar|uchar|short|int|uint|long|longlong|size|ptrdiff|bool|float|double|wchar)\\b"
        },
        {
          "name": "storage.type.meta.kelyra",
          "match": "\\b(?:std\\.meta\\.(?:Symbol|Type|Class|Field|Function|Parameter|Annotation)|std\\.util\\.string\\.StringSlice)\\b"
        },
        {
          "name": "storage.type.function.kelyra",
          "match": "\\bfn(?=\\s*\\()"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.kelyra",
      "match": "(?<![A-Za-z0-9_])(?:[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)(?![A-Za-z0-9_])"
    },
    "annotations": {
      "name": "entity.name.tag.kelyra",
      "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
    },
    "builtinMembers": {
      "patterns": [
        {
          "name": "variable.language.this.kelyra",
          "match": "\\bthis\\b"
        },
        {
          "name": "entity.name.function.lifecycle.kelyra",
          "match": "\\b(init|deinit|copy|move)(?=\\s*(?:<[^>]+>)?\\s*\\()"
        },
        {
          "name": "support.function.asm.kelyra",
          "match": "(?<=\\.)(in|out|op)\\b"
        },
        {
          "name": "support.function.reflection.kelyra",
          "match": "(?<=\\.)has_annotation\\b"
        },
        {
          "name": "support.variable.property.reflection.kelyra",
          "match": "(?<=\\.)is_public\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.kelyra",
      "match": "\\.\\.\\.|->|==|!=|<=|>=|&&|\\|\\||[=+\\-*/%!<>&]"
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "A module-qualified call: `math.int.scale(...)`.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\.([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.kelyra" },
            "2": { "name": "entity.name.function.kelyra" }
          }
        },
        {
          "comment": "A call in the current scope, including construction.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.kelyra" }
          }
        },
        {
          "comment": "A class field is a typed name at the start of its own line.",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:(?!:)",
          "captures": {
            "1": { "name": "variable.other.member.kelyra" }
          }
        },
        {
          "comment": "A function parameter, or any other typed binding.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*:(?!:)",
          "captures": {
            "1": { "name": "variable.parameter.kelyra" }
          }
        },
        {
          "comment": "Member access through a value, pointer, or namespace.",
          "match": "(?<=\\.)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.member.kelyra" }
          }
        },
        {
          "comment": "Any remaining identifier is a local or global variable.",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.readwrite.kelyra" }
          }
        }
      ]
    }
  }
}
