+static MDTuple *buildLegacySignatureList(Module &M, const MDNode *Source) {
+  if (!Source)
+    return nullptr;
+  LLVMContext &Ctx = M.getContext();
+  IRBuilder<> B(Ctx);
+  SmallVector<Metadata *> Entries;
+  for (unsigned I = 0; I < Source->getNumOperands(); ++I) {
+    auto *ElementNode = dyn_cast<MDNode>(Source->getOperand(I));
+    if (!ElementNode) {
+      reportError(M, "malformed shader semantic signature element");
+      return nullptr;
+    }
+    auto Element = hlsl::SemanticSignatureElement::fromMetadata(ElementNode);
+    if (!Element) {
+      consumeError(Element.takeError());
+      reportError(M, "invalid shader semantic signature element");
+      return nullptr;
+    }
+    SmallVector<Metadata *> Indices;
+    for (uint32_t Index : Element->SemanticIndices)
+      Indices.push_back(ConstantAsMetadata::get(B.getInt32(Index)));
+    auto *IndexNode = MDNode::get(Ctx, Indices);
+    const uint32_t Row = Element->isAllocated()
+                             ? Element->StartRow
+                             : (Element->SemanticName == "SV_Target" &&
+                                        !Element->SemanticIndices.empty()
+                                    ? Element->SemanticIndices.front()
+                                    : I);
+    const uint8_t Col = Element->isAllocated() ? Element->StartCol : 0;
+    const uint32_t UsedMask = ((1U << Element->Cols) - 1U) << Col;
+    auto *UsageNode =
+        MDNode::get(Ctx, {ConstantAsMetadata::get(B.getInt32(3)),
+                          ConstantAsMetadata::get(B.getInt32(UsedMask))});
+    Entries.push_back(MDNode::get(
+        Ctx, {ConstantAsMetadata::get(B.getInt32(Element->SigId)),
+              MDString::get(Ctx, Element->SemanticName),
+              ConstantAsMetadata::get(
+                  B.getInt8(static_cast<uint8_t>(Element->CompType))),
+              ConstantAsMetadata::get(
+                  B.getInt8(static_cast<uint8_t>(Element->SemanticKind))),
+              IndexNode,
+              ConstantAsMetadata::get(
+                  B.getInt8(static_cast<uint8_t>(Element->InterpMode))),
+              ConstantAsMetadata::get(B.getInt32(Element->Rows)),
+              ConstantAsMetadata::get(B.getInt8(Element->Cols)),
+              ConstantAsMetadata::get(B.getInt32(Row)),
+              ConstantAsMetadata::get(B.getInt8(Col)), UsageNode}));
+  }
+  return MDNode::get(Ctx, Entries);
+}
+
+static MDTuple *buildLegacySignatures(Module &M, const Function *Entry) {
+  auto *Semantic = M.getNamedMetadata("dx.semantic.signatures");
+  if (!Semantic)
+    return nullptr;
+  for (const MDNode *PerEntry : Semantic->operands()) {
+    if (PerEntry->getNumOperands() != 3)
+      continue;
+    auto *Reference = dyn_cast<ValueAsMetadata>(PerEntry->getOperand(0));
+    if (!Reference || Reference->getValue() != Entry)
+      continue;
+    auto *Input = dyn_cast_or_null<MDNode>(PerEntry->getOperand(1));
+    auto *Output = dyn_cast_or_null<MDNode>(PerEntry->getOperand(2));
+    return MDNode::get(M.getContext(),
+                       {buildLegacySignatureList(M, Input),
+                        buildLegacySignatureList(M, Output), nullptr});
+  }
+  return nullptr;
+}
