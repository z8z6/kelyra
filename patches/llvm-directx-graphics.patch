 namespace {
+struct GraphicsSignatures {
+  SmallVector<hlsl::SemanticSignatureElement> Inputs;
+  SmallVector<hlsl::SemanticSignatureElement> Outputs;
+};
+
+static uint32_t getSignatureInt(const MDNode *Node, unsigned Operand) {
+  if (!Node || Operand >= Node->getNumOperands())
+    report_fatal_error("malformed DXIL entry point signature");
+  const auto *Value =
+      mdconst::dyn_extract<ConstantInt>(Node->getOperand(Operand));
+  if (!Value)
+    report_fatal_error("DXIL entry point signature expects an integer");
+  return static_cast<uint32_t>(Value->getZExtValue());
+}
+
+static void
+readSignatureList(const MDNode *List,
+                  SmallVectorImpl<hlsl::SemanticSignatureElement> &Out) {
+  if (!List)
+    return;
+  for (const MDOperand &Operand : List->operands()) {
+    const auto *Node = dyn_cast<MDNode>(Operand.get());
+    if (!Node || Node->getNumOperands() != 11)
+      report_fatal_error("malformed DXIL entry point signature element");
+    const auto *Name = dyn_cast<MDString>(Node->getOperand(1));
+    const auto *Indices = dyn_cast<MDNode>(Node->getOperand(4));
+    if (!Name || !Indices)
+      report_fatal_error("DXIL entry point signature expects semantic data");
+    hlsl::SemanticSignatureElement Element;
+    Element.SigId = getSignatureInt(Node, 0);
+    Element.SemanticName = Name->getString();
+    Element.CompType = static_cast<dxil::ElementType>(getSignatureInt(Node, 2));
+    Element.SemanticKind =
+        static_cast<dxbc::PSV::SemanticKind>(getSignatureInt(Node, 3));
+    for (unsigned I = 0; I != Indices->getNumOperands(); ++I)
+      Element.SemanticIndices.push_back(getSignatureInt(Indices, I));
+    Element.InterpMode =
+        static_cast<dxbc::PSV::InterpolationMode>(getSignatureInt(Node, 5));
+    Element.Rows = getSignatureInt(Node, 6);
+    Element.Cols = getSignatureInt(Node, 7);
+    Element.StartRow = getSignatureInt(Node, 8);
+    Element.StartCol = getSignatureInt(Node, 9);
+    const auto *Usage = dyn_cast<MDNode>(Node->getOperand(10));
+    Element.UsageMask = getSignatureInt(Usage, 1);
+    if (Element.Rows != Element.SemanticIndices.size() || Element.Cols == 0 ||
+        Element.Cols > 4 || Element.StartCol > 3)
+      report_fatal_error("invalid DXIL entry point signature shape");
+    Out.push_back(std::move(Element));
+  }
+}
+
+static GraphicsSignatures readGraphicsSignatures(const Module &M,
+                                                 const Function *Entry) {
+  GraphicsSignatures Signatures;
+  const NamedMDNode *Metadata = M.getNamedMetadata("dx.entryPoints");
+  if (!Metadata || !Entry)
+    return Signatures;
+  for (const MDNode *PerEntry : Metadata->operands()) {
+    if (PerEntry->getNumOperands() != 5)
+      continue;
+    const auto *Reference = dyn_cast<ValueAsMetadata>(PerEntry->getOperand(0));
+    if (!Reference || Reference->getValue() != Entry)
+      continue;
+    const auto *Legacy = dyn_cast_or_null<MDNode>(PerEntry->getOperand(2));
+    if (Legacy && Legacy->getNumOperands() == 3) {
+      readSignatureList(dyn_cast_or_null<MDNode>(Legacy->getOperand(0)),
+                        Signatures.Inputs);
+      readSignatureList(dyn_cast_or_null<MDNode>(Legacy->getOperand(1)),
+                        Signatures.Outputs);
+    }
+    break;
+  }
+  return Signatures;
+}
+
+static uint32_t getStartRow(const hlsl::SemanticSignatureElement &Element,
+                            unsigned Sequence, bool IsOutput) {
+  if (Element.isAllocated())
+    return Element.StartRow;
+  if (IsOutput && Element.SemanticKind == dxbc::PSV::SemanticKind::Target &&
+      !Element.SemanticIndices.empty())
+    return Element.SemanticIndices.front();
+  return Sequence;
+}
+
+static uint8_t getStartCol(const hlsl::SemanticSignatureElement &Element) {
+  return Element.isAllocated() ? Element.StartCol : 0;
+}
+
+static dxbc::SigComponentType
+getSignatureComponentType(dxil::ElementType Type) {
+  switch (Type) {
+  case dxil::ElementType::I1:
+    return dxbc::SigComponentType::UInt32;
+  case dxil::ElementType::U16:
+    return dxbc::SigComponentType::UInt16;
+  case dxil::ElementType::I16:
+    return dxbc::SigComponentType::SInt16;
+  case dxil::ElementType::U32:
+    return dxbc::SigComponentType::UInt32;
+  case dxil::ElementType::I32:
+    return dxbc::SigComponentType::SInt32;
+  case dxil::ElementType::F16:
+  case dxil::ElementType::SNormF16:
+  case dxil::ElementType::UNormF16:
+    return dxbc::SigComponentType::Float16;
+  case dxil::ElementType::F32:
+  case dxil::ElementType::SNormF32:
+  case dxil::ElementType::UNormF32:
+    return dxbc::SigComponentType::Float32;
+  case dxil::ElementType::U64:
+    return dxbc::SigComponentType::UInt64;
+  case dxil::ElementType::I64:
+    return dxbc::SigComponentType::SInt64;
+  case dxil::ElementType::F64:
+  case dxil::ElementType::SNormF64:
+  case dxil::ElementType::UNormF64:
+    return dxbc::SigComponentType::Float64;
+  default:
+    return dxbc::SigComponentType::Unknown;
+  }
+}
+
+static dxbc::D3DSystemValue getSystemValue(dxbc::PSV::SemanticKind Kind) {
+  using KindType = dxbc::PSV::SemanticKind;
+  using ValueType = dxbc::D3DSystemValue;
+  switch (Kind) {
+  case KindType::Position:
+    return ValueType::Position;
+  case KindType::ClipDistance:
+    return ValueType::ClipDistance;
+  case KindType::CullDistance:
+    return ValueType::CullDistance;
+  case KindType::RenderTargetArrayIndex:
+    return ValueType::RenderTargetArrayIndex;
+  case KindType::ViewPortArrayIndex:
+    return ValueType::ViewPortArrayIndex;
+  case KindType::VertexID:
+    return ValueType::VertexID;
+  case KindType::PrimitiveID:
+    return ValueType::PrimitiveID;
+  case KindType::InstanceID:
+    return ValueType::InstanceID;
+  case KindType::IsFrontFace:
+    return ValueType::IsFrontFace;
+  case KindType::SampleIndex:
+    return ValueType::SampleIndex;
+  case KindType::Barycentrics:
+    return ValueType::Barycentrics;
+  case KindType::ShadingRate:
+    return ValueType::ShadingRate;
+  case KindType::CullPrimitive:
+    return ValueType::CullPrimitive;
+  case KindType::Target:
+    return ValueType::Target;
+  case KindType::Depth:
+    return ValueType::Depth;
+  case KindType::Coverage:
+    return ValueType::Coverage;
+  case KindType::DepthGreaterEqual:
+    return ValueType::DepthGE;
+  case KindType::DepthLessEqual:
+    return ValueType::DepthLE;
+  case KindType::StencilRef:
+    return ValueType::StencilRef;
+  case KindType::InnerCoverage:
+    return ValueType::InnerCoverage;
+  default:
+    return ValueType::Undefined;
+  }
+}
+
+static void
+addGraphicsSignatureElements(ArrayRef<hlsl::SemanticSignatureElement> Elements,
+                             bool IsOutput, Signature *Signature,
+                             SmallVectorImpl<PSVSignatureElement> *PSVElements,
+                             uint8_t &VectorCount) {
+  for (unsigned I = 0; I != Elements.size(); ++I) {
+    const auto &Element = Elements[I];
+    const uint32_t Row = getStartRow(Element, I, IsOutput);
+    if (Row > UINT8_MAX || Element.Rows > UINT8_MAX - Row)
+      report_fatal_error("DXIL semantic signature exceeds PSV vector range");
+    const uint8_t Col = getStartCol(Element);
+    const uint8_t Mask =
+        static_cast<uint8_t>(((1U << Element.Cols) - 1U) << Col);
+    const auto CompType = getSignatureComponentType(Element.CompType);
+    const auto SystemValue = getSystemValue(Element.SemanticKind);
+    const auto MinPrecision = Element.getMinPrecision(true);
+    for (unsigned R = 0; R != Element.Rows; ++R) {
+      const uint32_t Index = Element.SemanticIndices[R];
+      const uint8_t Exclusive =
+          IsOutput ? static_cast<uint8_t>(~Element.UsageMask & Mask)
+                   : static_cast<uint8_t>(Element.UsageMask & Mask);
+      Signature->addParam(Element.GSStream, Element.SemanticName, Index,
+                          SystemValue, CompType, Row + R, Mask, Exclusive,
+                          MinPrecision);
+    }
+    PSVElements->push_back(PSVSignatureElement{
+        Element.SemanticName, SmallVector<uint32_t>(Element.SemanticIndices),
+        static_cast<uint8_t>(Row), Element.Cols, Col, true,
+        Element.SemanticKind, static_cast<dxbc::PSV::ComponentType>(CompType),
+        Element.InterpMode, Element.DynIndexMask,
+        static_cast<uint8_t>(Element.GSStream)});
+    VectorCount = std::max<uint8_t>(VectorCount, Row + Element.Rows);
+  }
+}
