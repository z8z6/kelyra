import std.graphics.vulkan.window;
import std.io;
import std.io.file;
import std.os;

fn read_shader(path: *c.char, output: *u8, capacity: usize) -> i64 {
  let handle = std.io.file.open(path, 0);
  if handle < 0 {
    return handle;
  }
  let length = std.io.file.read(handle, output, capacity);
  std.io.file.close(handle);
  return length;
}

@main
fn main() -> i32 {
  let vertex: [4096]u8;
  let fragment: [4096]u8;
  let vertex_size = read_shader("build/vulkan_triangle.vert.spv", &vertex[0],
                                4096);
  let fragment_size = read_shader("build/vulkan_triangle.frag.spv",
                                  &fragment[0], 4096);
  if vertex_size <= 0 || fragment_size <= 0 {
    std.io.println("Cannot read compiled Kelyra shaders");
    return 1;
  }

  let window = std.graphics.vulkan.window.Window("Kelyra Vulkan triangle",
                                                 800, 600);
  if !window.valid() {
    std.io.println(std.graphics.vulkan.window.last_error());
    return 2;
  }
  if !window.set_pipeline(&vertex[0], vertex_size as usize,
                          &fragment[0], fragment_size as usize) {
    std.io.println(std.graphics.vulkan.window.last_error());
    return 3;
  }
  while window.poll() {
    if !window.draw(3, 0.08, 0.10, 0.16, 1.0) {
      std.io.println(std.graphics.vulkan.window.last_error());
      return 4;
    }
    std.os.sleep_millis(16);
  }
  return 0;
}
