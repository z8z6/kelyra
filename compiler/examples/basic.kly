annotation Vertex();

@Vertex
class Pair {
  first: i32;
  second: i32;
  init(first: i32, second: i32) {
    this.first = first;
    this.second = second;
  }
}

fn sum(values: [4]i32, count: i32) -> i32 {
  let total: i32 = 0;
  let i = 0;
  let s = "hello world!";
  while i < count {
    total = total + values[i];
    i = i + 1;
  }
  if total > 0 {
    return total;
  } else {
    return 0;
  }
}
