module cfg.main;
@cfg(os=os.Windows, arch=arch.AArch64) import missing.windows_module;

@cfg(arch.X86_64)
fn architecture_selected() -> i32 {
  return 0;
}

@cfg(os.Linux)
fn selected() -> i32 {
  return 42;
}

@cfg(os.Windows)
fn selected() -> i32 {
  return 1;
}

@main
fn main() -> i32 {
  return selected() + architecture_selected();
}
