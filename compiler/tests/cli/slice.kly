fn sum(values: []const i32) -> i32 {
  let total: i32 = 0;
  let i: usize = 0;
  while i < values.len {
    total = total + values[i];
    i = i + 1;
  }
  return total;
}

fn update(values: []i32) {
  values[0] = 10;
}

@main
fn main() -> i32 {
  let values: [4]i32;
  values[0] = 1;
  values[1] = 2;
  values[2] = 3;
  values[3] = 4;
  let middle: []i32 = values[1: 3];
  update(middle);
  let first: []const i32 = values[: 2];
  let last: []const i32 = values[2:];
  let all: []const i32 = values[:];
  if middle.len != 2 || first.len != 2 || last.len != 2 || all.len != 4 {
    return 1;
  }
  if sum(all) != 18 || sum(middle[: 1]) != 10 {
    return 2;
  }
  return 0;
}
