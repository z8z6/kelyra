class Counter {
  value: i32;

  init(value: i32) {
    this.value = value;
  }

  fn copy(other: *Counter) {
    value = other.value + 1;
  }

  fn move(other: *Counter) {
    value = other.value;
    other.value = 0;
  }
}

fn read(counter: Counter) -> i32 {
  return counter.value;
}

@main
fn main() -> i32 {
  let first = Counter(20);
  let second = first;
  first = Counter(5);
  return read(second) + first.value;
}
