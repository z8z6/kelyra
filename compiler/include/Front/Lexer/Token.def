// TOKEN(kind, spelling, display name, category, binding power)
TOKEN(illegal, "", "Illegal", None, -1)
TOKEN(name, "", "Name", None, -1)
TOKEN(number, "", "Number", None, -1)
TOKEN(string, "", "String", None, -1)
TOKEN(asm_text, "", "AsmText", None, -1)
TOKEN(keyword_let, "let", "let", Keyword, -1)
TOKEN(keyword_var, "", "var", None, -1)
TOKEN(keyword_fn, "fn", "fn", Keyword, -1)
TOKEN(keyword_class, "class", "class", Keyword, -1)
TOKEN(keyword_enum, "enum", "enum", Keyword, -1)
TOKEN(keyword_const, "const", "const", Keyword, -1)
TOKEN(keyword_this, "this", "this", Keyword, -1)
TOKEN(keyword_annotation, "annotation", "annotation", Keyword, -1)
TOKEN(keyword_if, "if", "if", Keyword, -1)
TOKEN(keyword_else, "else", "else", Keyword, -1)
TOKEN(keyword_while, "while", "while", Keyword, -1)
TOKEN(keyword_for, "for", "for", Keyword, -1)
TOKEN(keyword_in, "in", "in", Keyword, -1)
TOKEN(keyword_return, "return", "return", Keyword, -1)
TOKEN(keyword_break, "break", "break", Keyword, -1)
TOKEN(keyword_continue, "continue", "continue", Keyword, -1)
TOKEN(keyword_true, "true", "true", Keyword, -1)
TOKEN(keyword_false, "false", "false", Keyword, -1)
TOKEN(keyword_meta, "meta", "meta", Keyword, -1)
TOKEN(keyword_when, "when", "when", Keyword, -1)
TOKEN(keyword_match, "match", "match", Keyword, -1)
TOKEN(keyword_as, "as", "as", Keyword, 70)
TOKEN(keyword_parallel, "parallel", "parallel", Keyword, -1)
TOKEN(keyword_extern, "extern", "extern", Keyword, -1)
TOKEN(keyword_defer, "defer", "defer", Keyword, -1)
TOKEN(keyword_module, "module", "module", Keyword, -1)
TOKEN(keyword_import, "import", "import", Keyword, -1)
TOKEN(keyword_pub, "pub", "pub", Keyword, -1)
TOKEN(keyword_asm, "asm", "asm", Keyword, -1)
TOKEN(op_arrow, "->", "->", Punctuation, -1)
TOKEN(op_fat_arrow, "=>", "=>", Punctuation, -1)
TOKEN(op_assign, "=", "=", Punctuation, -1)
TOKEN(op_add, "+", "+", Punctuation, 50)
TOKEN(op_subtract, "-", "-", Punctuation, 50)
TOKEN(op_multiply, "*", "*", Punctuation, 60)
TOKEN(op_divide, "/", "/", Punctuation, 60)
TOKEN(op_remainder, "%", "%", Punctuation, 60)
TOKEN(op_equal, "==", "==", Punctuation, 30)
TOKEN(op_not_equal, "!=", "!=", Punctuation, 30)
TOKEN(op_less, "<", "<", Punctuation, 40)
TOKEN(op_less_equal, "<=", "<=", Punctuation, 40)
TOKEN(op_greater, ">", ">", Punctuation, 40)
TOKEN(op_greater_equal, ">=", ">=", Punctuation, 40)
TOKEN(op_and, "&&", "&&", Punctuation, 20)
TOKEN(op_or, "||", "||", Punctuation, 10)
TOKEN(op_not, "!", "!", Punctuation, -1)
TOKEN(op_address, "&", "&", Punctuation, -1)
TOKEN(punc_left_paren, "(", "(", Punctuation, 80)
TOKEN(punc_right_paren, ")", ")", Punctuation, -1)
TOKEN(punc_left_brace, "{", "{", Punctuation, -1)
TOKEN(punc_right_brace, "}", "}", Punctuation, -1)
TOKEN(punc_left_bracket, "[", "[", Punctuation, 80)
TOKEN(punc_right_bracket, "]", "]", Punctuation, -1)
TOKEN(punc_comma, ",", ",", Punctuation, -1)
TOKEN(punc_colon, ":", ":", Punctuation, -1)
TOKEN(punc_semicolon, ";", ";", Punctuation, -1)
TOKEN(punc_dot, ".", ".", Punctuation, 80)
TOKEN(punc_ellipsis, "...", "...", Punctuation, -1)
TOKEN(punc_at, "@", "@", Punctuation, -1)
TOKEN(comment, "", "Comment", None, -1)
TOKEN(end, "", "End", None, -1)
