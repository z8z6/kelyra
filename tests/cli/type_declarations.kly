alias Count = usize;

type UserId = i64;

alias PublicId = UserId;

fn add(left: UserId, right: PublicId) -> UserId {
  return left + right;
}

fn count(value: usize) -> Count {
  return value;
}

@main
fn main() -> i32 {
  let first: UserId = 20;
  let second: PublicId = 22 as UserId;
  let result = add(first, second);
  let number: Count = count(result as usize);
  return number as i32;
}
