@cfg(os="linux", arch="x86_64")
module std.graphics.vulkan.window;

// SDL3 supplies the window, swapchain, and command submission. The GPU device
// is explicitly created with its Vulkan backend and accepts SPIR-V shaders.
// Link window.c as a C source and link the SDL3 shared library.

@extern("kstd_vulkan_window_create")
@callconv(CallingConvention.C)
fn create_native(title: *c.char, width: i32, height: i32) -> *u8;

@extern("kstd_vulkan_window_destroy")
@callconv(CallingConvention.C)
fn destroy_native(handle: *u8) -> void;

@extern("kstd_vulkan_window_set_pipeline")
@callconv(CallingConvention.C)
fn set_pipeline_native(handle: *u8, vertex: *u8, vertex_size: usize,
                       fragment: *u8, fragment_size: usize) -> i32;

@extern("kstd_vulkan_window_draw")
@callconv(CallingConvention.C)
fn draw_native(handle: *u8, vertex_count: u32, red: f32, green: f32,
               blue: f32, alpha: f32) -> i32;

@extern("kstd_vulkan_window_poll")
@callconv(CallingConvention.C)
fn poll_native(handle: *u8) -> i32;

@extern("kstd_vulkan_window_error")
@callconv(CallingConvention.C)
fn error_native() -> *c.char;

pub fn last_error() -> *c.char {
  return error_native();
}

pub class Window {
  handle: *u8;

  pub init(title: *c.char, width: i32, height: i32) {
    handle = create_native(title, width, height);
  }

  deinit() {
    if handle as usize != 0 {
      destroy_native(handle);
    }
  }

  pub fn valid() -> bool {
    return handle as usize != 0;
  }

  // Both byte ranges must contain valid SPIR-V modules with a main entry point.
  // They are consumed during pipeline creation and need not outlive this call.
  pub fn set_pipeline(vertex: *u8, vertex_size: usize,
                      fragment: *u8, fragment_size: usize) -> bool {
    return set_pipeline_native(handle, vertex, vertex_size,
                               fragment, fragment_size) != 0;
  }

  // Draws procedural geometry without a vertex buffer.
  pub fn draw(vertex_count: u32, red: f32, green: f32,
              blue: f32, alpha: f32) -> bool {
    return draw_native(handle, vertex_count, red, green, blue, alpha) != 0;
  }

  // Returns false after the user closes the window.
  pub fn poll() -> bool {
    return poll_native(handle) != 0;
  }
}
