@cfg(os="linux", arch="x86_64") module std.sync.thread.hosted;

@extern("pthread_create")
@callconv(CallingConvention.C)
fn linux_pthread_create(thread_id: *usize, attributes: *u8,
                        callback: fn(*u8) -> *u8, context: *u8) -> i32;

@extern("pthread_join")
@callconv(CallingConvention.C)
fn linux_pthread_join(thread_id: usize, result: **u8) -> i32;

// The callback and context must remain valid until join.
// Returns zero or negative pthread error number.
pub fn spawn(callback: fn(*u8) -> *u8, context: *u8,
             thread_id: *usize) -> i64 {
  return -(linux_pthread_create(thread_id, 0 as *u8, callback, context) as i64);
}

pub fn join(thread_id: usize, result: **u8) -> i64 {
  return -(linux_pthread_join(thread_id, result) as i64);
}
