@cfg(os="windows", arch="x86_64") module std.ui.win;

import std.ui;
import std.ui.win.gdi;
import std.win.error;
import std.win.window;
import std.win.text;

@extern("SetCapture", "user32")
@callconv(CallingConvention.System)
fn set_capture(window: *u8) -> *u8;

@extern("ReleaseCapture", "user32")
@callconv(CallingConvention.System)
fn release_capture() -> i32;

@extern("IsWindow", "user32")
@callconv(CallingConvention.System)
fn is_window(window: *u8) -> i32;

fn procedure(window: *u8, message: u32, w_param: usize,
             l_param: isize) -> isize {
  return std.win.window.default_procedure(window, message, w_param, l_param);
}

fn coordinate(word: usize) -> i32 { return (word as u16) as i16 as i32; }

fn low_word(value: usize) -> u32 { return (value as u16) as u32; }
fn high_word(value: usize) -> u32 {
  return ((value / 65536) as u16) as u32;
}

fn class_name() -> [13]u16 {
  let name: [13]u16;
  name[0] = 75;  // KelyraUiHost
  name[1] = 101;
  name[2] = 108;
  name[3] = 121;
  name[4] = 114;
  name[5] = 97;
  name[6] = 85;
  name[7] = 105;
  name[8] = 72;
  name[9] = 111;
  name[10] = 115;
  name[11] = 116;
  name[12] = 0;
  return name;
}

// Owns a resizable Win32 window and a platform-neutral UI tree. Add controls
// through window.ui. The caller retains storage for every added control.
pub class Window {
  native: *u8;
  pub ui: std.ui.Window;
  opened: bool;
  width: i32;
  height: i32;
  gdi_enabled: bool;

  pub init(title_utf8: *c.char, client_width: i32, client_height: i32) {
    native = 0 as *u8;
    ui = std.ui.Window(client_width, client_height);
    opened = false;
    width = client_width;
    height = client_height;
    gdi_enabled = false;

    let title: [256]u16;
    if std.win.text.utf8_to_wide(65001, 0, title_utf8, -1, &title[0], 256) == 0 {
      return;
    }
    let name = class_name();
    let instance = std.win.window.module_handle(0 as *u16);
    let kind = std.win.window.WindowClassExW();
    kind.size = std.win.window.class_size();
    kind.procedure = procedure;
    kind.instance = instance;
    kind.class_name = &name[0];
    if std.win.window.register_class(&kind) == 0 &&
        std.win.error.last_error() != 1410 {
      return;
    }
    let style: u32 = 13565952; // WS_OVERLAPPEDWINDOW
    let outer = std.win.window.Rect();
    outer.right = client_width;
    outer.bottom = client_height;
    if std.win.window.adjust_window_rect(&outer, style, 0, 0) == 0 {
      return;
    }
    native = std.win.window.create_window(
        0, &name[0], &title[0], style, 100, 100,
        outer.right - outer.left, outer.bottom - outer.top,
        0 as *u8, 0 as *u8, instance, 0 as *u8);
    if native as usize == 0 { return; }
    opened = true;
    std.win.window.show_window(native, 5);
    std.win.window.update_window(native);
  }

  deinit() {
    if native as usize != 0 {
      std.win.window.destroy_window(native);
      native = 0 as *u8;
    }
  }

  pub fn valid() -> bool { return native as usize != 0; }
  pub fn handle() -> *u8 { return native; }
  pub fn client_width() -> i32 { return width; }
  pub fn client_height() -> i32 { return height; }

  // Enables built-in GDI rendering for retained controls. Leave disabled
  // when the same HWND is the target of a Vulkan or DX12 swapchain.
  pub fn set_ui_paint(enabled: bool) -> void {
    gdi_enabled = enabled;
    repaint();
  }

  pub fn repaint() -> void {
    if gdi_enabled && native as usize != 0 {
      std.ui.win.gdi.invalidate(native, 0 as *std.win.window.Rect, 0);
    }
  }

  // Dispatches all queued messages for this window and updates its UI tree.
  // Returns false after close. Call once per frame before rendering.
  pub fn poll() -> bool {
    if !opened { return false; }
    if is_window(native) == 0 {
      ui.close();
      native = 0 as *u8;
      opened = false;
      return false;
    }
    let message = std.win.window.Message();
    let dirty = false;
    while std.win.window.peek_message(&message, native, 0, 0, 1) != 0 {
      if message.message == 5 { // WM_SIZE
        width = low_word(message.l_param as usize) as i32;
        height = high_word(message.l_param as usize) as i32;
        ui.resize(width, height);
        dirty = true;
      } else if message.message == 15 && gdi_enabled { // WM_PAINT
        std.ui.win.gdi.paint(native, &ui);
        std.ui.win.gdi.validate(native, 0 as *std.win.window.Rect);
        dirty = false;
      } else if message.message == 512 { // WM_MOUSEMOVE
        ui.pointer(std.ui.EventKind.PointerMove,
                   coordinate(message.l_param as usize),
                   coordinate((message.l_param as usize) / 65536));
        dirty = true;
      } else if message.message == 513 { // WM_LBUTTONDOWN
        set_capture(native);
        ui.pointer(std.ui.EventKind.PointerDown,
                   coordinate(message.l_param as usize),
                   coordinate((message.l_param as usize) / 65536));
        dirty = true;
      } else if message.message == 514 { // WM_LBUTTONUP
        ui.pointer(std.ui.EventKind.PointerUp,
                   coordinate(message.l_param as usize),
                   coordinate((message.l_param as usize) / 65536));
        release_capture();
        dirty = true;
      } else if message.message == 256 { // WM_KEYDOWN
        ui.keyboard(std.ui.EventKind.KeyDown, message.w_param as u32, 0);
        dirty = true;
      } else if message.message == 257 { // WM_KEYUP
        ui.keyboard(std.ui.EventKind.KeyUp, message.w_param as u32, 0);
        dirty = true;
      } else if message.message == 258 { // WM_CHAR
        ui.keyboard(std.ui.EventKind.TextInput, 0, message.w_param as u32);
        dirty = true;
      } else if message.message == 16 { // WM_CLOSE
        ui.close();
        opened = false;
      } else if message.message == 2 { // WM_DESTROY
        opened = false;
      }
      std.win.window.translate_message(&message);
      std.win.window.dispatch_message(&message);
      if message.message == 16 || message.message == 2 {
        native = 0 as *u8;
        break;
      }
    }
    if dirty { repaint(); }
    return opened;
  }
}
