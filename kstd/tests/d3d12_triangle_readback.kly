@cfg(os="windows", arch="x86_64") module d3d12_triangle_readback;

import std.io;
import std.io.file;
import std.win.graphics.window;

fn read_shader(path: *c.char, output: *u8, capacity: usize) -> i64 {
  let handle = std.io.file.open(path, 0);
  if handle < 0 { return handle; }
  let length = std.io.file.read(handle, output, capacity);
  std.io.file.close(handle);
  return length;
}

@main
pub fn main() -> i32 {
  let vertex: [8192]u8;
  let fragment: [8192]u8;
  let vertex_size = read_shader("build/triangle.vs.dxil", &vertex[0], 8192);
  let fragment_size = read_shader("build/triangle.ps.dxil", &fragment[0], 8192);
  if vertex_size <= 0 || fragment_size <= 0 { return 1; }
  return std.win.graphics.window.run_verify(
      "Kelyra DX12 triangle test", 800, 600, &vertex[0],
      vertex_size as usize, &fragment[0], fragment_size as usize, 3);
}
