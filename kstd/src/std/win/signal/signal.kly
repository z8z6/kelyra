@cfg(os=os.Windows, arch=arch.X86_64) module std.win.signal;

import std.win.error;

@extern("GenerateConsoleCtrlEvent", "kernel32")
@callconv(cc.System)
fn win_generate_console_ctrl_event(event: u32, process_group: u32) -> i32;

@extern("SetConsoleCtrlHandler", "kernel32")
@callconv(cc.System)
fn win_set_console_callback(handler: fn(u32) -> i32, add: i32) -> i32;

// Windows may invoke the handler on a new thread. Keep it valid until removed.
pub fn register_console_handler(handler: fn(u32) -> i32) -> i64 {
  if win_set_console_callback(handler, 1) == 0 {
    return -(std.win.error.last_error() as i64);
  }
  return 0;
}

pub fn unregister_console_handler(handler: fn(u32) -> i32) -> i64 {
  if win_set_console_callback(handler, 0) == 0 {
    return -(std.win.error.last_error() as i64);
  }
  return 0;
}

// CTRL_C_EVENT=0, CTRL_BREAK_EVENT=1. The target must share a console.
// Returns zero or negative GetLastError; not equivalent to POSIX kill.
pub fn send_console_event(event: u32, process_group: u32) -> i64 {
  if event > 1 {
    return -87;
  }
  if win_generate_console_ctrl_event(event, process_group) == 0 {
    return -(std.win.error.last_error() as i64);
  }
  return 0;
}

// NULL handler toggles the process-wide CTRL+C ignore state. This does not
// install a Kelyra callback; child processes can inherit this state.
pub fn ignore_control_c(ignore: bool) -> i64 {
  let add: i32 = 0;
  if ignore {
    add = 1;
  }
  if win_set_console_callback(0 as fn(u32) -> i32, add) == 0 {
    return -(std.win.error.last_error() as i64);
  }
  return 0;
}
