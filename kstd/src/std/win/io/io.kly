@cfg(os=os.Windows, arch=arch.X86_64) module std.win.io;

import std.win.file;

@extern("GetStdHandle", "kernel32")
@callconv(cc.System)
fn get_std_handle(which: i32) -> *u8;

pub fn read_stdin(output: *u8, capacity: usize) -> i64 {
  return std.win.file.read(get_std_handle(-10) as i64, output, capacity);
}

pub fn write_stdout(data: *u8, count: usize) -> i64 {
  return std.win.file.write(get_std_handle(-11) as i64, data, count);
}

pub fn write_stderr(data: *u8, count: usize) -> i64 {
  return std.win.file.write(get_std_handle(-12) as i64, data, count);
}
