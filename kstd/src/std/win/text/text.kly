@cfg(os=os.Windows, arch=arch.X86_64) module std.win.text;

@extern("MultiByteToWideChar", "kernel32")
@callconv(cc.System)
pub fn utf8_to_wide(code_page: u32, flags: u32, source: *c.char,
                     source_length: i32, destination: *u16,
                     destination_length: i32) -> i32;
