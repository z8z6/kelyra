@cfg(os=os.Windows, arch=arch.X86_64) module std.win.system;

import std.win.error;

@extern("GetCurrentProcessId", "kernel32")
@callconv(cc.System)
fn win_process_id() -> u32;

@extern("QueryPerformanceCounter", "kernel32")
@callconv(cc.System)
fn win_performance_counter(value: *i64) -> i32;

@extern("QueryPerformanceFrequency", "kernel32")
@callconv(cc.System)
fn win_performance_frequency(value: *i64) -> i32;

@extern("Sleep", "kernel32")
@callconv(cc.System)
fn win_sleep(milliseconds: u32) -> void;

@extern("GetEnvironmentVariableA", "kernel32")
@callconv(cc.System)
fn win_environment(name: *c.char, output: *u8, capacity: u32) -> u32;

@extern("GetCurrentDirectoryA", "kernel32")
@callconv(cc.System)
fn win_current_directory(capacity: u32, output: *u8) -> u32;

// Win32 process ID. The value is an unsigned 32-bit integer.
pub fn process_id() -> u32 {
  return win_process_id();
}

// Monotonic elapsed milliseconds, or -1 if the performance clock fails.
pub fn monotonic_millis() -> i64 {
  let counter: i64 = 0;
  let frequency: i64 = 0;
  if win_performance_counter(&counter) == 0 || win_performance_frequency(&frequency) == 0 || frequency <= 0 {
    return -1;
  }
  return (counter / frequency) * 1000 + ((counter % frequency) * 1000) / frequency;
}

// Sleep has no error return. The maximum duration is 0xfffffffe milliseconds;
// 0xffffffff is reserved as INFINITE by Win32.
pub fn sleep_millis(milliseconds: u32) -> void {
  win_sleep(milliseconds);
}

// Returns the number of bytes copied, or required capacity when too small.
// Zero also means an empty or absent variable; inspect last_error() then.
pub fn environment(name: *c.char, output: *u8, capacity: u32) -> u32 {
  return win_environment(name, output, capacity);
}

// Returns bytes copied excluding NUL, or required capacity when too small.
pub fn working_directory(output: *u8, capacity: u32) -> u32 {
  return win_current_directory(capacity, output);
}

pub fn last_error() -> u32 {
  return std.win.error.last_error();
}
