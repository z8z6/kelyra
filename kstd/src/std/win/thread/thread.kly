@cfg(os=os.Windows, arch=arch.X86_64) module std.win.thread;

import std.win.error;
import std.win.handle;
import std.win.wait;

@extern("CreateThread", "kernel32")
@callconv(cc.System)
fn win_create_thread(attributes: *u8, stack_size: usize,
                     callback: fn(*u8) -> u32, context: *u8,
                     flags: u32, thread_id: *u32) -> *u8;

@extern("GetExitCodeThread", "kernel32")
@callconv(cc.System)
fn win_get_exit_code_thread(handle: *u8, exit_code: *u32) -> i32;

// The caller owns the returned handle and must close it after join.
// The callback and context must remain valid until the thread exits.
pub fn spawn(callback: fn(*u8) -> u32, context: *u8,
             thread_id: *u32) -> *u8 {
  return win_create_thread(0 as *u8, 0, callback, context, 0, thread_id);
}

// Waits indefinitely and writes the thread's exit code. Does not close handle.
pub fn join(handle: *u8, exit_code: *u32) -> i64 {
  if std.win.wait.one(handle, 4294967295) != 0 {
    return -(std.win.error.last_error() as i64);
  }
  if win_get_exit_code_thread(handle, exit_code) == 0 {
    return -(std.win.error.last_error() as i64);
  }
  return 0;
}

pub fn close(handle: *u8) -> i64 {
  if std.win.handle.close(handle) == 0 {
    return -(std.win.error.last_error() as i64);
  }
  return 0;
}

@extern("GetCurrentThreadId", "kernel32")
@callconv(cc.System)
fn win_current_thread_id() -> u32;

@extern("SwitchToThread", "kernel32")
@callconv(cc.System)
fn win_switch_to_thread() -> i32;

@extern("WaitOnAddress", "Synchronization")
@callconv(cc.System)
fn win_wait_on_address(address: *u32, expected: *u32, size: usize,
                       milliseconds: u32) -> i32;

@extern("WakeByAddressSingle", "Synchronization")
@callconv(cc.System)
fn win_wake_by_address_single(address: *u32) -> void;

@extern("WakeByAddressAll", "Synchronization")
@callconv(cc.System)
fn win_wake_by_address_all(address: *u32) -> void;

pub fn current_id() -> u32 {
  return win_current_thread_id();
}

// Returns true only when Windows actually switched to another thread.
pub fn yield_now() -> bool {
  return win_switch_to_thread() != 0;
}

// Returns zero after waking, or negative GetLastError. The caller must
// recheck the word using atomic operations, even after a successful wait.
pub fn wait_word(address: *u32, expected: u32) -> i64 {
  let comparison: u32 = expected;
  if win_wait_on_address(address, &comparison, 4, 4294967295) == 0 {
    return -(std.win.error.last_error() as i64);
  }
  return 0;
}

// Windows does not report the number of waiters woken.
pub fn wake_one(address: *u32) -> void {
  win_wake_by_address_single(address);
}

pub fn wake_all(address: *u32) -> void {
  win_wake_by_address_all(address);
}
