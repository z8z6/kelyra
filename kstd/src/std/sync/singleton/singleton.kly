module std.sync.singleton;

import std.alloc;
import std.memory;
import std.sync.once;

@target(Target.Class T)
pub annotation singleton() {
  @static
  __singleton_state: u32;
  @static
  __singleton_value: *T;
  @static
  pub fn instance() -> *T {
    let once = Once(&__singleton_state);
    if once.begin() {
      let storage = allocate(size_of<T>(0 as *T)) as *T;
      if storage as usize == 0 {
        once.finish(false);
        return storage;
      }
      init_default<T>(storage);
      __singleton_value = storage;
      once.finish(true);
    }
    return __singleton_value;
  }
}
