@cfg(os="linux", arch="x86_64") module std.sync.signal.hosted;

@extern("signal")
@callconv(CallingConvention.C)
fn linux_signal(number: i32, handler: fn(i32) -> void) -> fn(i32) -> void;

// Returns the previous handler, or SIG_ERR on failure. The callback may run
// asynchronously and must use only async-signal-safe operations.
pub fn install_handler(number: i32, handler: fn(i32) -> void)
    -> fn(i32) -> void {
  return linux_signal(number, handler);
}
