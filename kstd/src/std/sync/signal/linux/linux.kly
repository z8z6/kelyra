@cfg(os=os.Linux, arch=arch.X86_64) module std.sync.signal.linux;

// kill(2). Signal zero performs permission/existence checking only.
// Returns zero or negative Linux errno.
pub fn send_process(process_id: i64, number: i32) -> i64 {
  let syscall_number: i64 = 62;
  let signal_number: i64 = number as i64;
  asm {
    syscall
  }
  .in(syscall_number, rax)
  .out(syscall_number, rax)
  .in(process_id, rdi)
  .in(signal_number, rsi)
  .op(clobber(rcx, r11));
  return syscall_number;
}

// tgkill(2): send a signal to one thread in a known thread group.
pub fn send_thread(process_id: i64, thread_id: i64, number: i32) -> i64 {
  let syscall_number: i64 = 234;
  let signal_number: i64 = number as i64;
  asm {
    syscall
  }
  .in(syscall_number, rax)
  .out(syscall_number, rax)
  .in(process_id, rdi)
  .in(thread_id, rsi)
  .in(signal_number, rdx)
  .op(clobber(rcx, r11));
  return syscall_number;
}
