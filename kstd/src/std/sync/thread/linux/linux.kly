@cfg(os=os.Linux, arch=arch.X86_64) module std.sync.thread.linux;

// Linux x86-64 gettid(2). A thread ID is not a process ID.
pub fn current_id() -> i64 {
  let number: i64 = 186;
  asm {
    syscall
  }
  .in(number, rax)
  .out(number, rax)
  .op(clobber(rcx, r11));
  return number;
}

// sched_yield(2): zero or negative Linux errno.
pub fn yield_now() -> i64 {
  let number: i64 = 24;
  asm {
    syscall
  }
  .in(number, rax)
  .out(number, rax)
  .op(clobber(rcx, r11));
  return number;
}

// Process-private futex. The caller must use atomic operations to change
// the aligned 32-bit word; a wakeup does not prove its value changed.
// Returns zero or negative Linux errno (-11 means value mismatch).
pub fn wait_word(address: *u32, expected: u32) -> i64 {
  let number: i64 = 202;
  let operation: i64 = 128;
  let value: i64 = expected as i64;
  let timeout: usize = 0;
  asm {
    syscall
  }
  .in(number, rax)
  .out(number, rax)
  .in(address, rdi)
  .in(operation, rsi)
  .in(value, rdx)
  .in(timeout, r10)
  .op(clobber(rcx, r11));
  return number;
}

// Returns the number woken or negative Linux errno.
pub fn wake_one(address: *u32) -> i64 {
  let number: i64 = 202;
  let operation: i64 = 129;
  let count: i64 = 1;
  asm {
    syscall
  }
  .in(number, rax)
  .out(number, rax)
  .in(address, rdi)
  .in(operation, rsi)
  .in(count, rdx)
  .op(clobber(rcx, r11));
  return number;
}

// INT_MAX waiters, not an exact count; returns number woken or -errno.
pub fn wake_all(address: *u32) -> i64 {
  let number: i64 = 202;
  let operation: i64 = 129;
  let count: i64 = 2147483647;
  asm {
    syscall
  }
  .in(number, rax)
  .out(number, rax)
  .in(address, rdi)
  .in(operation, rsi)
  .in(count, rdx)
  .op(clobber(rcx, r11));
  return number;
}
