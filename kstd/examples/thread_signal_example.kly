import std.sync.signal;
import std.sync.thread;

@cfg(os = os.Windows, arch = arch.X86_64)
import std.win.signal;

@cfg(os = os.Linux, arch = arch.X86_64)
@main
pub fn main() -> i32 {
  let id: i64 = current_id();
  if id <= 0 || yield_now() != 0 {
    return 1;
  }
  let word: u32 = 7;
  if wait_word(&word, 8) != -11 {
    return 2;
  }
  if wake_one(&word) != 0 || wake_all(&word) != 0 {
    return 3;
  }
  // This smoke test runs on the initial thread, whose Linux TID equals PID.
  let pid: i64 = id;
  if send_process(pid, 0) != 0 {
    return 4;
  }
  if send_thread(pid, id, 0) != 0 {
    return 5;
  }
  return 0;
}

@cfg(os = os.Windows, arch = arch.X86_64)
@main
pub fn main() -> i32 {
  if current_id() <= 0 || yield_now() != 0 {
    return 1;
  }
  let word: u32 = 7;
  if wait_word(&word, 8) != 0 {
    return 2;
  }
  if wake_one(&word) != 0 || wake_all(&word) != 0 {
    return 3;
  }
  if send_console_event(2, 0) != -87 {
    return 4;
  }
  if ignore_control_c(true) != 0 {
    return 5;
  }
  if ignore_control_c(false) != 0 {
    return 6;
  }
  return 0;
}
