@cfg(os=os.Windows, arch=arch.X86_64)
import std.os;
@cfg(os=os.Windows, arch=arch.X86_64)
import std.graphics.ui;
@cfg(os=os.Windows, arch=arch.X86_64)
import std.graphics.ui.win;

@cfg(os=os.Windows, arch=arch.X86_64)
fn on_click(context: *u8, event: *std.graphics.ui.Event) -> void {
  if event.kind == std.graphics.ui.EventKind.Click {
    let button = context as *std.graphics.ui.Button;
    button.label = "Clicked!";
  }
}

@cfg(os=os.Windows, arch=arch.X86_64)
fn on_drag(context: *u8, event: *std.graphics.ui.Event) -> void {
  if event.kind == std.graphics.ui.EventKind.DragMove {
    let panel = context as *std.graphics.ui.Panel;
    panel.bounds.x = panel.bounds.x + event.delta_x;
    panel.bounds.y = panel.bounds.y + event.delta_y;
  }
}

@cfg(os=os.Windows, arch=arch.X86_64)
@main
pub fn main() -> i32 {
  let window = std.graphics.ui.win.Window("Kelyra UI controls", 720, 480);
  if !window.valid() { return 1; }

  let panel = std.graphics.ui.Panel(20, 20, 680, 440);
  panel.set_anchors(std.graphics.ui.Anchor.Stretch, std.graphics.ui.Anchor.Stretch,
                           20, 20);
  let heading = std.graphics.ui.Label("Kelyra UI", 20, 22, 300, 32);
  let button = std.graphics.ui.Button("Click me", 20, 80, 180, 44);
  button.set_handler(on_click, (&button) as *u8);
  let slider = std.graphics.ui.Slider(20, 160, 320, 28);
  slider.set_value(0.35);
  let draggable = std.graphics.ui.Panel(20, 230, 150, 70);
  draggable.draggable = true;
  draggable.background.red = 0.50;
  draggable.background.green = 0.28;
  draggable.background.blue = 0.30;
  draggable.set_handler(on_drag, (&draggable) as *u8);

  if !window.ui.add(&panel) ||
      !panel.add(&heading) ||
      !panel.add(&button) ||
      !panel.add(&slider) ||
      !panel.add(&draggable) {
    return 2;
  }
  window.set_ui_paint(true);
  while window.poll() { std.os.sleep_millis(16); }
  return 0;
}
