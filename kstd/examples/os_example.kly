import std.alloc;
import std.io;
import std.os;

@main
pub fn main() -> i32 {
  if process_id() <= 0 {
    return 1;
  }
  let before: i64 = monotonic_millis();
  if before < 0 || sleep_millis(1) != 0 {
    return 2;
  }
  if monotonic_millis() < before {
    return 3;
  }
  if sleep_millis(-1) == 0 {
    return 4;
  }
  let buffer: *u8 = allocate(256);
  if is_null(buffer) {
    return 5;
  }
  let length: i64 = working_directory(buffer, 256);
  if length <= 1 || load(buffer, 0) == 0 {
    release(buffer);
    return 9;
  }
  if working_directory(buffer, 1) >= 0 {
    release(buffer);
    return 10;
  }
  release(buffer);
  let environment: [128]u8;
  let size = std.os.environment("KSTD_OS_TEST", &environment[0], 128);
  if size < 1 || size > 128 {
    return 11;
  }
  println((&environment[0]) as *c.char);
  return 0;
}
