@cfg(os=os.Windows, arch=arch.X86_64)
import std.graphics.ui.win;
@cfg(os=os.Windows, arch=arch.X86_64)
import std.graphics.ui.win.gdi;
@cfg(os=os.Windows, arch=arch.X86_64)
import std.graphics.ui;
@cfg(os=os.Windows, arch=arch.X86_64)
import std.win.window;

@cfg(os=os.Windows, arch=arch.X86_64)
@main
pub fn main() -> i32 {
  let window = std.graphics.ui.win.Window("Kelyra UI", 320, 240);
  if !window.valid() { return 1; }
  if window.handle() as usize == 0 { return 2; }
  let panel = std.graphics.ui.Panel(10, 10, 200, 180);
  let label = std.graphics.ui.Label("Label", 10, 55, 100, 25);
  let button = std.graphics.ui.Button("Button", 10, 10, 100, 30);
  let slider = std.graphics.ui.Slider(10, 95, 100, 20);
  slider.set_value(0.5);
  if !window.ui.add(&panel) { return 8; }
  if !panel.add(&label) ||
      !panel.add(&button) ||
      !panel.add(&slider) { return 9; }
  window.set_ui_paint(true);
  if !window.poll() { return 3; }
  let pixel = std.graphics.ui.win.gdi.pixel(window.handle(), 15, 15);
  if pixel != 2958110 { return 10; }
  if std.graphics.ui.win.gdi.pixel(window.handle(), 30, 110) != 16777215 {
    return 11;
  }
  if std.graphics.ui.win.gdi.pixel(window.handle(), 90, 110) != 4013373 {
    return 12;
  }
  if std.win.window.post_message(window.handle(), 5, 0,
                                 350 * 65536 + 400) == 0 { return 4; }
  if !window.poll() || window.client_width() != 400 ||
      window.client_height() != 350 { return 5; }
  if std.win.window.post_message(window.handle(), 16, 0, 0) == 0 {
    return 6;
  }
  if window.poll() { return 7; }
  return 0;
}
